<!DOCTYPE html>
<html lang="tr" class="scroll-smooth">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title || category.name %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet"/>
  <style>
    body{font-family:'Inter',system-ui,sans-serif;}.gecis{transition:all .2s ease;}
    .no-scrollbar::-webkit-scrollbar{display:none;}.no-scrollbar{-ms-overflow-style:none;scrollbar-width:none;}
  </style>
</head>
<%
var d = (konfig && konfig.duzen) ? konfig.duzen : 'koy-kahvaltisi';
var isDark = (d==='sushi-kartlar'||d==='premium-koyu');
%>
<% if(d==='premium-koyu'){ %>
<style>
  .glass{background:rgba(255,255,255,.04);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.07);}
  .grad-text{background:linear-gradient(135deg,#c084fc,#f472b6,#818cf8);-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
</style>
<% } %>
<body class="min-h-screen
  <% if(d==='premium-koyu'){%>bg-[#070714] text-white<%}else if(d==='sushi-kartlar'){%>bg-slate-900 text-white<%}else if(d==='vegan-minimal'){%>bg-white text-zinc-800<%}else if(d==='bistro-editoryal'){%>bg-white text-zinc-900<%}else if(d==='modern-galeri'){%>bg-slate-50 text-slate-800<%}else{%>bg-amber-50 text-stone-800<%}%>">

<!-- ── HEADER ──────────────────────────────────────────────────────────── -->
<% if(d==='premium-koyu'){ %>
<header class="sticky top-0 z-50 border-b border-purple-900/20" style="background:rgba(7,7,20,.85);backdrop-filter:blur(20px)">
<% }else{ %>
<header class="sticky top-0 z-50 border-b
  <% if(d==='sushi-kartlar'){%>bg-slate-950 border-slate-800<%}
  else if(d==='vegan-minimal'){%>bg-white border-green-100<%}
  else if(d==='bistro-editoryal'){%>bg-white border-b-2 border-zinc-900<%}
  else if(d==='koy-kahvaltisi'){%>bg-white/90 border-amber-100<%}
  else{%>bg-white border-slate-200 shadow-sm<%}%>">
<% } %>
  <div class="max-w-5xl mx-auto px-4 h-14 flex items-center gap-3">
    <a href="<%= baseUrl %>" class="flex items-center justify-center w-9 h-9 rounded-full gecis flex-shrink-0
      <% if(isDark){%>bg-white/10 hover:bg-white/20 text-white<%}else if(d==='vegan-minimal'){%>bg-green-50 hover:bg-green-100 text-green-700<%}else if(d==='koy-kahvaltisi'){%>bg-amber-50 hover:bg-amber-100 text-amber-700<%}else{%>bg-slate-100 hover:bg-slate-200 text-slate-600<%}%>"
      aria-label="Geri">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6"/></svg>
    </a>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-1.5 text-xs mb-0.5
        <% if(isDark){%>text-slate-500<%}else{%>text-slate-400<%}%>">
        <a href="<%= baseUrl %>" class="gecis truncate
          <% if(d==='vegan-minimal'){%>hover:text-green-600<%}else if(d==='koy-kahvaltisi'){%>hover:text-amber-700<%}else if(isDark){%>hover:text-slate-300<%}else{%>hover:text-slate-600<%}%>">
          <%= menu.businessName %>
        </a>
        <span>/</span>
        <span class="font-medium truncate
          <% if(isDark){%>text-white<%}else if(d==='bistro-editoryal'){%>text-zinc-900<%}else{%>text-slate-700<%}%>"><%= category.name %></span>
      </div>
    </div>
  </div>
</header>

<!-- ── KATEGORİ TABS ───────────────────────────────────────────────────── -->
<div class="sticky top-14 z-40 border-b
  <% if(isDark){%>border-slate-800<%}else if(d==='vegan-minimal'){%>border-green-100 bg-white<%}else if(d==='koy-kahvaltisi'){%>border-amber-100 bg-amber-50<%}else if(d==='bistro-editoryal'){%>border-zinc-200 bg-white<%}else{%>border-slate-100 bg-white<%}%>">
  <div class="max-w-5xl mx-auto px-4">
    <div class="flex gap-2 overflow-x-auto py-2 no-scrollbar">
      <% categories.forEach(function(cat) { %>
        <a href="<%= baseUrl %>/c/<%= cat.slug %>"
           class="flex-shrink-0 px-3 py-1.5 rounded-full text-xs font-semibold gecis whitespace-nowrap
             <% if(cat.id === category.id){
               if(d==='premium-koyu'){%>bg-purple-600 text-white shadow-lg shadow-purple-900/40<%}
               else if(d==='sushi-kartlar'){%>bg-indigo-500 text-white<%}
               else if(d==='vegan-minimal'){%>bg-green-600 text-white<%}
               else if(d==='bistro-editoryal'){%>bg-zinc-900 text-white<%}
               else if(d==='koy-kahvaltisi'){%>bg-amber-600 text-white<%}
               else{%>bg-sky-600 text-white<%}
             }else{
               if(isDark){%>bg-slate-800 text-slate-400 hover:text-white hover:bg-slate-700<%}
               else if(d==='vegan-minimal'){%>bg-green-50 text-green-700 hover:bg-green-100<%}
               else if(d==='koy-kahvaltisi'){%>bg-amber-100 text-amber-700 hover:bg-amber-200<%}
               else{%>bg-slate-100 text-slate-600 hover:bg-slate-200<%}
             }%>">
          <%= cat.name %>
        </a>
      <% }); %>
    </div>
  </div>
</div>

<!-- ── KATEGORİ HERO ─────────────────────────────────────────────────── -->
<% if(d==='koy-kahvaltisi'){ %>
<div class="bg-gradient-to-r from-amber-600 to-amber-700 py-8 px-4 text-white">
  <div class="max-w-5xl mx-auto">
    <h1 class="font-['Playfair_Display',serif] text-3xl font-bold mb-1"><%= category.name %></h1>
    <p class="text-amber-200 text-sm"><%= products.length %> lezzet</p>
  </div>
</div>
<% }else if(d==='vegan-minimal'){ %>
<div class="max-w-5xl mx-auto px-4 pt-8 pb-4">
  <h1 class="text-3xl font-bold text-zinc-800 mb-1"><%= category.name %></h1>
  <div class="w-10 h-1 bg-green-500 rounded-full mb-2"></div>
  <p class="text-green-600 text-xs tracking-widest uppercase"><%= products.length %> ürün</p>
</div>
<% }else if(d==='bistro-editoryal'){ %>
<div class="max-w-5xl mx-auto px-4 py-8 border-b-2 border-zinc-100">
  <p class="text-[10px] tracking-[0.4em] text-zinc-300 uppercase mb-2">menü seçkisi</p>
  <h1 class="font-['Playfair_Display',serif] text-4xl font-bold text-zinc-900"><%= category.name %></h1>
  <p class="text-zinc-400 text-sm mt-1"><%= products.length %> ürün</p>
</div>
<% }else if(d==='sushi-kartlar'){ %>
<div class="relative border-b border-slate-800 py-10 px-4 overflow-hidden">
  <div class="absolute inset-0" style="background:repeating-linear-gradient(0deg,rgba(99,102,241,.03) 0,rgba(99,102,241,.03) 1px,transparent 1px,transparent 40px),repeating-linear-gradient(90deg,rgba(99,102,241,.03) 0,rgba(99,102,241,.03) 1px,transparent 1px,transparent 40px)"></div>
  <div class="relative max-w-5xl mx-auto">
    <p class="text-indigo-400 text-[10px] tracking-[0.4em] uppercase mb-2">◉ kategori</p>
    <h1 class="text-3xl font-black text-white mb-1"><%= category.name %></h1>
    <div class="w-16 h-0.5 bg-indigo-500"></div>
  </div>
</div>
<% }else if(d==='premium-koyu'){ %>
<div class="relative py-12 text-center overflow-hidden" style="background:linear-gradient(135deg,#070714,#150a2e,#070714)">
  <div class="absolute inset-0" style="background:radial-gradient(ellipse 100% 100% at 50% 0%,rgba(139,92,246,.15),transparent 70%)"></div>
  <div class="relative">
    <p class="text-purple-400 text-[10px] tracking-[0.4em] uppercase mb-3">seçili kategori</p>
    <h1 class="text-3xl font-black text-white mb-2"><%= category.name %></h1>
    <p class="text-slate-500 text-sm"><%= products.length %> ürün</p>
  </div>
</div>
<% }else{ %>
<div class="bg-gradient-to-br from-sky-600 to-sky-700 py-8 px-4 text-white">
  <div class="max-w-5xl mx-auto">
    <h1 class="text-3xl font-black mb-1"><%= category.name %></h1>
    <p class="text-sky-200 text-sm"><%= products.length %> ürün</p>
  </div>
</div>
<% } %>

<!-- ── ÜRÜNLER ────────────────────────────────────────────────────────── -->
<main class="max-w-5xl mx-auto px-4 py-6 pb-24">
  <% if(products.length === 0){ %>
    <div class="py-20 text-center">
      <div class="text-5xl mb-4">🍽</div>
      <h2 class="text-xl font-bold mb-2 <% if(isDark){%>text-white<%}%>">Henüz ürün yok</h2>
      <p class="text-sm <% if(isDark){%>text-slate-400<%}else{%>text-slate-400<%}%>">Bu kategoride henüz ürün bulunmuyor.</p>
      <a href="<%= baseUrl %>" class="inline-block mt-4 text-sm font-semibold
        <% if(d==='vegan-minimal'){%>text-green-600<%}else if(d==='koy-kahvaltisi'){%>text-amber-700<%}else if(isDark){%>text-indigo-400<%}else{%>text-sky-600<%}%>">← Menüye Dön</a>
    </div>
  <% }else if(d==='vegan-minimal'){ %>
    <!-- Vegan Minimal: yuvarlak küçük resim + yatay liste -->
    <div class="space-y-3">
      <% products.forEach(function(p){ %>
      <a href="<%= baseUrl %>/p/<%= p.slug %>"
         class="flex items-center gap-4 p-3 rounded-2xl gecis bg-white hover:shadow-md border border-transparent hover:border-green-100 group">
        <div class="w-16 h-16 rounded-full overflow-hidden flex-shrink-0 bg-green-50 border-2 border-green-100">
          <% if(p.imageUrl){ %>
          <img src="<%= p.imageUrl %>" alt="<%= p.name %>" class="w-full h-full object-cover group-hover:scale-110 gecis"/>
          <% }else{ %>
          <div class="w-full h-full flex items-center justify-center text-2xl">🍃</div>
          <% } %>
        </div>
        <div class="flex-1 min-w-0">
          <p class="font-semibold text-zinc-800 truncate"><%= p.name %></p>
          <% if(p.description){ %><p class="text-zinc-400 text-xs truncate mt-0.5"><%= p.description %></p><% } %>
        </div>
        <span class="font-bold text-green-600 flex-shrink-0">₺<%= p.price %></span>
      </a>
      <% }); %>
    </div>
  <% }else if(d==='bistro-editoryal'){ %>
    <!-- Bistro Editoryal: sık düzenli satırlar -->
    <div class="divide-y divide-zinc-100">
      <% products.forEach(function(p){ %>
      <a href="<%= baseUrl %>/p/<%= p.slug %>"
         class="flex items-center gap-5 py-4 group gecis hover:bg-zinc-50 px-2 -mx-2 rounded-xl">
        <% if(p.imageUrl){ %>
        <div class="w-16 h-16 rounded-xl overflow-hidden flex-shrink-0">
          <img src="<%= p.imageUrl %>" alt="<%= p.name %>" class="w-full h-full object-cover group-hover:scale-105 gecis"/>
        </div>
        <% }else{ %>
        <div class="w-16 h-16 rounded-xl bg-zinc-50 flex items-center justify-center text-2xl flex-shrink-0">🍽</div>
        <% } %>
        <div class="flex-1 min-w-0">
          <p class="font-['Playfair_Display',serif] font-bold text-zinc-900 truncate group-hover:text-zinc-600 gecis"><%= p.name %></p>
          <% if(p.description){ %><p class="text-zinc-400 text-xs truncate mt-0.5"><%= p.description %></p><% } %>
        </div>
        <div class="text-right flex-shrink-0">
          <span class="font-black text-zinc-900 text-lg">₺<%= p.price %></span>
        </div>
      </a>
      <% }); %>
    </div>
  <% }else if(d==='koy-kahvaltisi'){ %>
    <!-- Köy Kahvaltısı: resim solda yatay kart -->
    <div class="space-y-4">
      <% products.forEach(function(p){ %>
      <a href="<%= baseUrl %>/p/<%= p.slug %>"
         class="flex gap-4 bg-white rounded-2xl overflow-hidden border border-amber-100 gecis hover:shadow-md hover:border-amber-200 group">
        <div class="w-28 flex-shrink-0 bg-amber-50">
          <% if(p.imageUrl){ %>
          <img src="<%= p.imageUrl %>" alt="<%= p.name %>" class="w-full h-full object-cover min-h-[96px] group-hover:scale-105 gecis"/>
          <% }else{ %>
          <div class="min-h-[96px] flex items-center justify-center text-3xl">🌾</div>
          <% } %>
        </div>
        <div class="flex-1 min-w-0 py-4 pr-4">
          <p class="font-['Playfair_Display',serif] font-bold text-stone-800"><%= p.name %></p>
          <% if(p.description){ %><p class="text-stone-500 text-xs mt-1 line-clamp-2"><%= p.description %></p><% } %>
          <p class="text-amber-700 font-bold text-sm mt-2">₺<%= p.price %></p>
        </div>
      </a>
      <% }); %>
    </div>
  <% }else if(isDark){ %>
    <!-- Karanlık temalar: glass kartlar -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <% products.forEach(function(p){ %>
      <a href="<%= baseUrl %>/p/<%= p.slug %>"
         class="group flex gap-4 rounded-2xl overflow-hidden gecis border
           <% if(d==='premium-koyu'){%>glass border-white/5 hover:border-purple-500/30<%}else{%>bg-slate-800/50 border-slate-700/50 hover:border-indigo-500/50<%}%>">
        <div class="w-24 flex-shrink-0">
          <% if(p.imageUrl){ %>
          <img src="<%= p.imageUrl %>" alt="<%= p.name %>" class="w-full h-full object-cover min-h-[88px] group-hover:scale-105 gecis"/>
          <% }else{ %>
          <div class="min-h-[88px] flex items-center justify-center text-3xl
            <% if(d==='premium-koyu'){%>bg-purple-900/20<%}else{%>bg-slate-700<%}%>">🍽</div>
          <% } %>
        </div>
        <div class="flex-1 min-w-0 py-3 pr-3">
          <p class="font-semibold text-white truncate"><%= p.name %></p>
          <% if(p.description){ %><p class="text-slate-400 text-xs mt-0.5 line-clamp-2"><%= p.description %></p><% } %>
          <p class="font-bold text-sm mt-2
            <% if(d==='premium-koyu'){%>text-transparent bg-gradient-to-r from-purple-300 to-pink-300 bg-clip-text<%}else{%>text-indigo-400<%}%>">
            ₺<%= p.price %></p>
        </div>
      </a>
      <% }); %>
    </div>
  <% }else{ %>
    <!-- Modern Galeri + diğerleri: kart grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      <% products.forEach(function(p){ %>
      <a href="<%= baseUrl %>/p/<%= p.slug %>"
         class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md gecis border border-slate-100 hover:border-sky-200 flex flex-col">
        <div class="h-40 bg-slate-50 overflow-hidden">
          <% if(p.imageUrl){ %>
          <img src="<%= p.imageUrl %>" alt="<%= p.name %>" class="w-full h-full object-cover group-hover:scale-105 gecis"/>
          <% }else{ %>
          <div class="w-full h-full flex items-center justify-center text-4xl text-slate-200">🍽</div>
          <% } %>
        </div>
        <div class="p-3 flex-1 flex flex-col">
          <p class="font-semibold text-slate-800 text-sm truncate"><%= p.name %></p>
          <% if(p.description){ %><p class="text-slate-400 text-xs mt-0.5 flex-1 line-clamp-2"><%= p.description %></p><% } %>
          <p class="font-bold text-sky-600 text-sm mt-2">₺<%= p.price %></p>
        </div>
      </a>
      <% }); %>
    </div>
  <% } %>
</main>

<!-- ── FOOTER ────────────────────────────────────────────────────────── -->
<footer class="border-t py-4 text-center text-xs
  <% if(isDark){%>border-slate-800 text-slate-600<%}else if(d==='koy-kahvaltisi'){%>border-amber-100 text-stone-400<%}else{%>border-slate-100 text-slate-400<%}%>">
  <a href="<%= baseUrl %>" class="gecis
    <% if(d==='vegan-minimal'){%>text-green-600<%}else if(d==='koy-kahvaltisi'){%>text-amber-700<%}else if(isDark){%>text-indigo-400<%}else{%>text-sky-500<%}%>">← <%= menu.businessName %></a>
  <span class="ml-2 opacity-50">· QR Menü</span>
</footer>

</body>
</html>
