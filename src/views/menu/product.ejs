<!DOCTYPE html>
<html lang="tr" class="scroll-smooth">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title || product.name %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet"/>
  <style>
    body{font-family:'Inter',system-ui,sans-serif;}.gecis{transition:all .2s ease;}
    .no-scrollbar::-webkit-scrollbar{display:none;}.no-scrollbar{-ms-overflow-style:none;scrollbar-width:none;}
  </style>
</head>
<%
var d = (konfig && konfig.duzen) ? konfig.duzen : 'koy-kahvaltisi';
var isDark = (d==='sushi-kartlar'||d==='premium-koyu');
var catUrl = category ? baseUrl + '/c/' + category.slug : baseUrl;
var related = (menu.products || []).filter(function(p){ return category && p.categoryId === category.id && p.id !== product.id; }).slice(0, 4);
%>
<% if(d==='premium-koyu'){ %>
<style>
  .glass{background:rgba(255,255,255,.04);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.07);}
  .grad-text{background:linear-gradient(135deg,#c084fc,#f472b6,#818cf8);-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
</style>
<% } %>
<body class="min-h-screen
  <% if(d==='premium-koyu'){%>bg-[#070714] text-white<%}else if(d==='sushi-kartlar'){%>bg-slate-900 text-white<%}else if(d==='vegan-minimal'){%>bg-white text-zinc-800<%}else if(d==='bistro-editoryal'){%>bg-white text-zinc-900<%}else if(d==='modern-galeri'){%>bg-slate-50 text-slate-800<%}else{%>bg-amber-50 text-stone-800<%}%>">

<!-- ── HEADER ──────────────────────────────────────────────────────────── -->
<% if(d==='premium-koyu'){ %>
<header class="sticky top-0 z-50 border-b border-purple-900/20" style="background:rgba(7,7,20,.85);backdrop-filter:blur(20px)">
<% }else{ %>
<header class="sticky top-0 z-50 border-b
  <% if(d==='sushi-kartlar'){%>bg-slate-950 border-slate-800<%}
  else if(d==='vegan-minimal'){%>bg-white border-green-100<%}
  else if(d==='bistro-editoryal'){%>bg-white border-b-2 border-zinc-900<%}
  else if(d==='koy-kahvaltisi'){%>bg-white/90 border-amber-100<%}
  else{%>bg-white border-slate-200 shadow-sm<%}%>">
<% } %>
  <div class="max-w-5xl mx-auto px-4 h-14 flex items-center gap-3">
    <a href="<%= catUrl %>" class="flex items-center justify-center w-9 h-9 rounded-full flex-shrink-0 gecis
      <% if(isDark){%>bg-white/10 hover:bg-white/20 text-white<%}else if(d==='vegan-minimal'){%>bg-green-50 hover:bg-green-100 text-green-700<%}else if(d==='koy-kahvaltisi'){%>bg-amber-50 hover:bg-amber-100 text-amber-700<%}else{%>bg-slate-100 hover:bg-slate-200 text-slate-600<%}%>"
      aria-label="Geri">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6"/></svg>
    </a>
    <nav class="flex items-center gap-1 text-xs overflow-hidden flex-1 min-w-0
      <% if(isDark){%>text-slate-500<%}else{%>text-slate-400<%}%>">
      <a href="<%= baseUrl %>" class="gecis truncate flex-shrink-0
        <% if(d==='vegan-minimal'){%>hover:text-green-600<%}else if(d==='koy-kahvaltisi'){%>hover:text-amber-700<%}else if(isDark){%>hover:text-slate-300<%}else{%>hover:text-slate-600<%}%>">
        <%= menu.businessName %>
      </a>
      <% if(category){ %>
        <span class="flex-shrink-0">/</span>
        <a href="<%= catUrl %>" class="gecis truncate flex-shrink-0
          <% if(d==='vegan-minimal'){%>hover:text-green-600<%}else if(d==='koy-kahvaltisi'){%>hover:text-amber-700<%}else if(isDark){%>hover:text-slate-300<%}else{%>hover:text-slate-600<%}%>">
          <%= category.name %>
        </a>
      <% } %>
      <span class="flex-shrink-0">/</span>
      <span class="font-medium truncate
        <% if(isDark){%>text-white<%}else{%>text-slate-800<%}%>"><%= product.name %></span>
    </nav>
  </div>
</header>

<!-- ── ÜRÜN DETAY ─────────────────────────────────────────────────────── -->
<main class="max-w-2xl mx-auto px-4 pt-6 pb-28">

  <!-- Ürün görseli -->
  <div class="rounded-2xl overflow-hidden mb-6
    <% if(isDark){%>border border-slate-800<%}else if(d==='koy-kahvaltisi'){%>border border-amber-100<%}else{%>shadow-sm<%}%>"
    style="height:260px">
    <% if(product.imageUrl){ %>
    <img src="<%= product.imageUrl %>" alt="<%= product.name %>" class="w-full h-full object-cover"/>
    <% }else{ %>
    <div class="w-full h-full flex items-center justify-center text-7xl
      <% if(d==='premium-koyu'){%>bg-purple-900/20<%}else if(d==='sushi-kartlar'){%>bg-slate-800<%}else if(d==='vegan-minimal'){%>bg-green-50<%}else if(d==='koy-kahvaltisi'){%>bg-amber-50<%}else{%>bg-slate-100<%}%>">🍽</div>
    <% } %>
  </div>

  <!-- Kategori badge -->
  <% if(category){ %>
  <a href="<%= catUrl %>" class="inline-block text-xs font-semibold px-3 py-1 rounded-full mb-3 gecis
    <% if(d==='premium-koyu'){%>bg-purple-900/40 text-purple-300 hover:bg-purple-900/60<%}
    else if(d==='sushi-kartlar'){%>bg-indigo-900/50 text-indigo-300 hover:bg-indigo-900/70<%}
    else if(d==='vegan-minimal'){%>bg-green-50 text-green-700 hover:bg-green-100<%}
    else if(d==='bistro-editoryal'){%>bg-zinc-100 text-zinc-600 hover:bg-zinc-200<%}
    else if(d==='koy-kahvaltisi'){%>bg-amber-100 text-amber-700 hover:bg-amber-200<%}
    else{%>bg-sky-50 text-sky-700 hover:bg-sky-100<%}%>">
    <%= category.name %>
  </a>
  <% } %>

  <!-- Ürün adı -->
  <h1 class="text-2xl font-extrabold leading-tight mb-2
    <% if(d==='premium-koyu'){%>grad-text<%}
    else if(isDark){%>text-white<%}
    else if(d==='bistro-editoryal'||d==='koy-kahvaltisi'){%>font-['Playfair_Display',serif] text-3xl<%}
    else{%>text-slate-900<%}%>">
    <%= product.name %>
  </h1>

  <!-- Fiyat -->
  <div class="flex items-baseline gap-2 my-4">
    <span class="text-3xl font-black
      <% if(d==='premium-koyu'){%>text-transparent bg-gradient-to-r from-purple-300 to-pink-300 bg-clip-text<%}
      else if(d==='sushi-kartlar'){%>text-indigo-400<%}
      else if(d==='vegan-minimal'){%>text-green-600<%}
      else if(d==='koy-kahvaltisi'){%>text-amber-700<%}
      else if(d==='bistro-editoryal'){%>text-zinc-900<%}
      else{%>text-sky-600<%}%>">₺<%= product.price %></span>
  </div>

  <hr class="my-4 <% if(isDark){%>border-slate-800<%}else if(d==='koy-kahvaltisi'){%>border-amber-100<%}else{%>border-slate-100<%}%>"/>

  <!-- Açıklama -->
  <div class="mb-6">
    <h3 class="text-sm font-bold mb-2
      <% if(isDark){%>text-slate-400<%}else if(d==='bistro-editoryal'){%>font-['Playfair_Display',serif] text-zinc-500<%}else{%>text-slate-500<%}%>">
      Açıklama
    </h3>
    <% if(product.description){ %>
    <p class="text-sm leading-relaxed
      <% if(isDark){%>text-slate-300<%}else if(d==='koy-kahvaltisi'){%>text-stone-600<%}else{%>text-slate-600<%}%>">
      <%= product.description %>
    </p>
    <% }else{ %>
    <p class="text-sm italic
      <% if(isDark){%>text-slate-600<%}else{%>text-slate-400<%}%>">Açıklama mevcut değil.</p>
    <% } %>
  </div>

  <!-- İpuçları -->
  <ul class="space-y-2 mb-8">
    <li class="flex items-center gap-2.5 text-sm
      <% if(isDark){%>text-slate-400<%}else{%>text-slate-500<%}%>">
      <span class="w-7 h-7 rounded-full flex items-center justify-center flex-shrink-0 text-xs
        <% if(d==='vegan-minimal'){%>bg-green-50<%}else if(d==='koy-kahvaltisi'){%>bg-amber-50<%}else if(isDark){%>bg-slate-800<%}else{%>bg-emerald-50<%}%>">✓</span>
      Taze malzemeler
    </li>
    <li class="flex items-center gap-2.5 text-sm
      <% if(isDark){%>text-slate-400<%}else{%>text-slate-500<%}%>">
      <span class="w-7 h-7 rounded-full flex items-center justify-center flex-shrink-0 text-xs
        <% if(isDark){%>bg-slate-800<%}else{%>bg-blue-50<%}%>">🕐</span>
      Sipariş üzerine hazırlanır
    </li>
  </ul>

  <!-- Geri dön butonu -->
  <a href="<%= catUrl %>"
     class="w-full flex items-center justify-center gap-2 font-bold py-4 px-6 rounded-2xl gecis text-sm
       <% if(d==='premium-koyu'){%>bg-purple-600 hover:bg-purple-500 text-white shadow-lg shadow-purple-900/40<%}
       else if(d==='sushi-kartlar'){%>bg-indigo-600 hover:bg-indigo-500 text-white<%}
       else if(d==='vegan-minimal'){%>bg-green-600 hover:bg-green-500 text-white<%}
       else if(d==='bistro-editoryal'){%>bg-zinc-900 hover:bg-zinc-700 text-white<%}
       else if(d==='koy-kahvaltisi'){%>bg-amber-600 hover:bg-amber-500 text-white<%}
       else{%>bg-sky-600 hover:bg-sky-500 text-white<%}%>">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6"/></svg>
    <%= category ? category.name + ' Kategorisine Dön' : 'Menüye Dön' %>
  </a>

  <!-- Kategorideki diğer ürünler -->
  <% if(related.length > 0){ %>
  <div class="mt-8 pt-6 border-t
    <% if(isDark){%>border-slate-800<%}else if(d==='koy-kahvaltisi'){%>border-amber-100<%}else{%>border-slate-100<%}%>">
    <p class="text-xs font-bold uppercase tracking-widest mb-4
      <% if(isDark){%>text-slate-500<%}else if(d==='koy-kahvaltisi'){%>text-stone-400<%}else{%>text-slate-400<%}%>">
      <%= category ? category.name + ' kategorisinden daha fazlası' : 'Diğer ürünler' %>
    </p>
    <div class="space-y-3">
      <% related.forEach(function(rp){ %>
      <a href="<%= baseUrl %>/p/<%= rp.slug %>"
         class="flex items-center gap-3 rounded-xl p-2 gecis group
           <% if(isDark){%>hover:bg-white/5<%}else{%>hover:bg-slate-50<%}%>">
        <div class="w-12 h-12 rounded-xl overflow-hidden flex-shrink-0
          <% if(isDark){%>bg-slate-800<%}else if(d==='koy-kahvaltisi'){%>bg-amber-50<%}else{%>bg-slate-100<%}%>">
          <% if(rp.imageUrl){ %>
          <img src="<%= rp.imageUrl %>" alt="<%= rp.name %>" class="w-full h-full object-cover"/>
          <% }else{ %>
          <div class="w-full h-full flex items-center justify-center text-xl">🍽</div>
          <% } %>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold truncate gecis
            <% if(isDark){%>text-white group-hover:text-slate-200<%}else{%>text-slate-800 group-hover:text-slate-600<%}%>">
            <%= rp.name %>
          </p>
          <p class="text-xs font-bold
            <% if(d==='premium-koyu'){%>text-purple-400<%}else if(d==='sushi-kartlar'){%>text-indigo-400<%}else if(d==='vegan-minimal'){%>text-green-600<%}else if(d==='koy-kahvaltisi'){%>text-amber-700<%}else{%>text-sky-600<%}%>">
            ₺<%= rp.price %>
          </p>
        </div>
        <svg class="w-4 h-4 flex-shrink-0
          <% if(isDark){%>text-slate-600 group-hover:text-slate-400<%}else{%>text-slate-300 group-hover:text-slate-500<%}%> gecis"
          fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/>
        </svg>
      </a>
      <% }); %>
    </div>
  </div>
  <% } %>

</main>

<!-- ── FOOTER ────────────────────────────────────────────────────────── -->
<footer class="border-t py-4 text-center text-xs
  <% if(isDark){%>border-slate-800 text-slate-600<%}else if(d==='koy-kahvaltisi'){%>border-amber-100 text-stone-400<%}else{%>border-slate-100 text-slate-400<%}%>">
  <a href="<%= baseUrl %>" class="gecis
    <% if(d==='vegan-minimal'){%>text-green-600<%}else if(d==='koy-kahvaltisi'){%>text-amber-700<%}else if(isDark){%>text-indigo-400<%}else{%>text-sky-500<%}%>">← <%= menu.businessName %></a>
  <span class="ml-2 opacity-50">· QR Menü</span>
</footer>

</body>
</html>

