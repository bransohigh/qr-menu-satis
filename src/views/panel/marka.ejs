<!DOCTYPE html>
<html lang="tr" class="h-full">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Marka Kiti — Panel</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="h-full bg-gray-50">
<%- include('../partials/panel-nav') %>
<main class="max-w-2xl mx-auto px-4 py-10">

  <h1 class="text-2xl font-bold text-gray-900 mb-2">Marka Kiti</h1>
  <p class="text-gray-500 mb-8">Logonuzu ve marka renklerinizi ayarlayın. Seçtiğiniz renkler menünüzde butonlar, fiyatlar ve vurgularda kullanılır.</p>

  <% if (flash === 'kaydedildi') { %>
  <div class="mb-6 bg-green-50 border border-green-200 text-green-700 rounded-xl px-4 py-3 flex items-center gap-2">
    <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
    Marka kiti başarıyla kaydedildi!
  </div>
  <% } %>

  <form action="/panel/api/marka" method="POST" enctype="multipart/form-data" class="space-y-6">

    <!-- Logo -->
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
      <h2 class="text-lg font-semibold text-gray-800 mb-4">Logo</h2>

      <% if (menu.logoUrl) { %>
      <div class="mb-4 flex items-center gap-4">
        <img src="<%= menu.logoUrl %>" alt="Mevcut Logo" class="h-16 object-contain rounded-lg border border-gray-200 bg-white p-2"/>
        <span class="text-sm text-gray-500">Mevcut logonuz</span>
      </div>
      <% } %>

      <label class="block text-sm font-medium text-gray-700 mb-2">
        <%= menu.logoUrl ? 'Logoyu Değiştir' : 'Logo Yükle' %> (PNG, SVG, JPG — maks. 5MB)
      </label>
      <input type="file" name="logo" accept="image/png,image/svg+xml,image/jpeg,image/webp"
        class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer"/>
      <p class="mt-1 text-xs text-gray-400">Logo yoksa menüde işletme adınız görünür.</p>
    </div>

    <!-- Renkler -->
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
      <h2 class="text-lg font-semibold text-gray-800 mb-1">Marka Renkleri</h2>
      <p class="text-sm text-gray-500 mb-5">Renk seçmezseniz tema kendi varsayılan renklerini kullanır.</p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <!-- Ana Renk -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Ana Renk</label>
          <div class="flex items-center gap-3">
            <input type="color" name="primaryColor" id="primaryColor"
              value="<%= brand.primaryColor || '#6366f1' %>"
              class="h-10 w-14 rounded-lg border border-gray-200 cursor-pointer p-1"/>
            <input type="text" id="primaryColorText"
              value="<%= brand.primaryColor || '#6366f1' %>"
              onchange="document.getElementById('primaryColor').value=this.value"
              oninput="syncColor('primaryColor','primaryColorText')"
              maxlength="7" placeholder="#6366f1"
              class="flex-1 px-3 py-2 text-sm border border-gray-200 rounded-lg font-mono focus:outline-none focus:ring-2 focus:ring-indigo-300"/>
          </div>
          <p class="mt-1 text-xs text-gray-400">Butonlar, badge, aktif kategori</p>
        </div>

        <!-- İkincil Renk -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">İkincil Renk</label>
          <div class="flex items-center gap-3">
            <input type="color" name="secondaryColor" id="secondaryColor"
              value="<%= brand.secondaryColor || '#e0e7ff' %>"
              class="h-10 w-14 rounded-lg border border-gray-200 cursor-pointer p-1"/>
            <input type="text" id="secondaryColorText"
              value="<%= brand.secondaryColor || '#e0e7ff' %>"
              oninput="syncColor('secondaryColor','secondaryColorText')"
              maxlength="7" placeholder="#e0e7ff"
              class="flex-1 px-3 py-2 text-sm border border-gray-200 rounded-lg font-mono focus:outline-none focus:ring-2 focus:ring-indigo-300"/>
          </div>
          <p class="mt-1 text-xs text-gray-400">Arkaplan tonu, ikincil alanlar</p>
        </div>

        <!-- Vurgu Renk -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Vurgu Rengi <span class="text-gray-400 font-normal">(opsiyonel)</span></label>
          <div class="flex items-center gap-3">
            <input type="color" name="accentColor" id="accentColor"
              value="<%= brand.accentColor || '#f59e0b' %>"
              class="h-10 w-14 rounded-lg border border-gray-200 cursor-pointer p-1"/>
            <input type="text" id="accentColorText"
              value="<%= brand.accentColor || '#f59e0b' %>"
              oninput="syncColor('accentColor','accentColorText')"
              maxlength="7" placeholder="#f59e0b"
              class="flex-1 px-3 py-2 text-sm border border-gray-200 rounded-lg font-mono focus:outline-none focus:ring-2 focus:ring-indigo-300"/>
          </div>
          <p class="mt-1 text-xs text-gray-400">Fiyat, etiket, özel vurgular</p>
        </div>
      </div>

      <!-- Önizleme -->
      <div class="mt-6 p-4 rounded-xl border border-gray-100 bg-gray-50">
        <p class="text-xs font-medium text-gray-500 mb-3">Canlı Önizleme</p>
        <div class="flex flex-wrap gap-3 items-center">
          <button type="button" id="prevPrimary" class="px-4 py-2 rounded-lg text-white text-sm font-medium transition-colors" style="background:<%= brand.primaryColor || '#6366f1' %>">Ana Buton</button>
          <span id="prevBadge" class="px-3 py-1 rounded-full text-sm font-medium" style="background:<%= brand.secondaryColor || '#e0e7ff' %>; color:<%= brand.primaryColor || '#6366f1' %>">Kategori</span>
          <span id="prevPrice" class="font-bold text-lg" style="color:<%= brand.accentColor || '#f59e0b' %>">₺125.00</span>
          <span class="text-sm text-gray-500">← fiyat vurgusu</span>
        </div>
      </div>
    </div>

    <button type="submit"
      class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl transition-colors shadow-sm">
      Kaydet
    </button>
  </form>
</main>

<script>
function syncColor(inputId, textId) {
  const val = document.getElementById(textId).value;
  if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
    document.getElementById(inputId).value = val;
    updatePreview();
  }
}
document.getElementById('primaryColor').addEventListener('input', function() {
  document.getElementById('primaryColorText').value = this.value;
  updatePreview();
});
document.getElementById('secondaryColor').addEventListener('input', function() {
  document.getElementById('secondaryColorText').value = this.value;
  updatePreview();
});
document.getElementById('accentColor').addEventListener('input', function() {
  document.getElementById('accentColorText').value = this.value;
  updatePreview();
});
function updatePreview() {
  const p = document.getElementById('primaryColor').value;
  const s = document.getElementById('secondaryColor').value;
  const a = document.getElementById('accentColor').value;
  document.getElementById('prevPrimary').style.background = p;
  document.getElementById('prevBadge').style.background = s;
  document.getElementById('prevBadge').style.color = p;
  document.getElementById('prevPrice').style.color = a;
}
</script>
</body>
</html>
