<%
var d = konfig.duzen;
var koyu = konfig.koyuMod;
var onizlemeBase = '/onizleme/' + tema.slug;
var kat = kategori;
var isDark = (d==='sushi-kartlar'||d==='premium-koyu'||d==='gece-modu'||d==='premium');
%><!DOCTYPE html>
<html lang="tr" class="scroll-smooth">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= urun.name %> — <%= menu.businessName %> Önizleme</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <style>
    body{font-family:'Inter',system-ui,sans-serif;}.gecis{transition:all .2s ease;}
    .thumb{cursor:pointer;transition:all .15s;}
    .thumb:hover{opacity:1!important;transform:scale(1.04);}
    .glass{background:rgba(255,255,255,.08);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.12);}
  </style>
</head>
<body class="min-h-screen <% if(d==='premium-koyu'){%>bg-[#070714] text-white<%}else if(d==='sushi-kartlar'){%>bg-slate-900 text-white<%}else if(isDark){%>bg-slate-950 text-white<%}else if(d==='vegan-minimal'){%>bg-white text-zinc-800<%}else if(d==='bistro-editoryal'){%>bg-white text-zinc-900<%}else if(d==='koy-kahvaltisi'){%>bg-amber-50 text-stone-800<%}else{%>bg-slate-50 text-slate-800<%}%>">

<!-- Önizleme bandı -->
<div class="sticky top-0 z-[60] bg-amber-400 text-amber-950 text-xs font-bold flex items-center justify-between px-4 py-2.5">
  <span>👀 ÖNİZLEME</span>
  <a href="/temalar/<%= tema.slug %>" class="bg-amber-900 text-amber-50 px-3 py-1 rounded-full text-xs hover:bg-amber-800 gecis">Satın Al →</a>
</div>

<!-- Header -->
<header class="sticky top-8 z-50 border-b shadow-sm
  <% if(isDark){%>bg-slate-950 border-slate-800<%}else if(d==='koy-kahvaltisi'){%>bg-white border-amber-100<%}else if(d==='vegan-minimal'){%>bg-white border-green-100<%}else if(d==='bistro-editoryal'){%>bg-white border-zinc-200<%}else{%>bg-white border-slate-200<%}%>">
  <div class="max-w-4xl mx-auto px-4 h-12 flex items-center gap-2 text-sm">
    <a href="<%= onizlemeBase %>" class="<% if(isDark){%>text-slate-400 hover:text-white<%}else{%>text-slate-400 hover:text-slate-800<%}%> gecis">Ana Sayfa</a>
    <span class="<% if(isDark){%>text-slate-700<%}else{%>text-slate-200<%}%>">/</span>
    <a href="<%= onizlemeBase %>/k/<%= kat.slug||kat.id %>" class="<% if(isDark){%>text-slate-400 hover:text-white<%}else{%>text-slate-400 hover:text-slate-800<%}%> gecis"><%= kat.name %></a>
    <span class="<% if(isDark){%>text-slate-700<%}else{%>text-slate-200<%}%>">/</span>
    <span class="font-semibold truncate max-w-[160px] <% if(isDark){%>text-white<%}%>"><%= urun.name %></span>
  </div>
</header>

<!-- Ana içerik: 2 sütun -->
<main class="max-w-4xl mx-auto px-4 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">

    <!-- Sol: Görsel + galeri -->
    <div>
      <!-- Ana görsel -->
      <div class="rounded-2xl overflow-hidden aspect-square bg-slate-100
        <% if(koyu){%>bg-slate-900<%}%>" id="mainImg">
        <% if(urun.imageUrl){ %>
        <img src="<%= urun.imageUrl %>" alt="<%= urun.name %>" class="w-full h-full object-cover" id="mainImgEl"/>
        <% }else{ %>
        <div class="w-full h-full flex items-center justify-center text-6xl"><%= kat.emoji %></div>
        <% } %>
      </div>
      <!-- Galeri küçük resimler -->
      <% if(urun.gallery && urun.gallery.length>1){ %>
      <div class="flex gap-2 mt-3 overflow-x-auto pb-1">
        <% urun.gallery.forEach(function(img,gi){ %>
        <button onclick="document.getElementById('mainImgEl').src=this.dataset.src"
                data-src="<%= img %>"
                class="thumb w-16 h-16 rounded-lg overflow-hidden shrink-0 border-2 gecis
                  <% if(gi===0){%>border-slate-400 opacity-100<%}else{%>border-transparent opacity-60<%}%>">
          <img src="<%= img %>" alt="" class="w-full h-full object-cover"/>
        </button>
        <% }); %>
      </div>
      <% } %>
    </div>

    <!-- Sağ: Bilgi kartı (sticky) -->
    <div class="lg:sticky lg:top-24 space-y-5">
      <!-- Kategori badge -->
      <span class="text-xs font-semibold px-3 py-1 rounded-full
        <% if(d==='premium-koyu'){%>bg-purple-900/50 text-purple-300<%}
        else if(d==='sushi-kartlar'){%>bg-indigo-900/50 text-indigo-400<%}
        else if(d==='gece-modu'){%>bg-cyan-900/50 text-cyan-400<%}
        else if(d==='premium'){%>bg-purple-900/50 text-purple-300<%}
        else if(d==='vegan-minimal'){%>bg-green-50 text-green-700<%}
        else if(d==='koy-kahvaltisi'){%>bg-amber-100 text-amber-800<%}
        else{%>bg-slate-100 text-slate-500<%}%>">
        <%= kat.emoji %> <%= kat.name %>
      </span>

      <!-- Ürün adı -->
      <h1 class="text-3xl font-black leading-tight
        <% if(isDark){%>text-white<%}else if(d==='koy-kahvaltisi'){%>text-stone-800<%}else if(d==='bistro-editoryal'){%>text-zinc-900<%}else{%>text-slate-900<%}%>"><%= urun.name %></h1>

      <!-- Fiyat -->
      <div class="flex items-center gap-3">
        <span class="text-4xl font-black
          <% if(d==='premium-koyu'){%>text-transparent bg-gradient-to-r from-purple-300 to-pink-300 bg-clip-text<%}
          else if(d==='sushi-kartlar'){%>text-indigo-400<%}
          else if(d==='gece-modu'){%>text-cyan-400<%}
          else if(d==='premium'){%>text-transparent bg-gradient-to-r from-purple-300 to-pink-300 bg-clip-text<%}
          else if(d==='vegan-minimal'){%>text-green-600<%}
          else if(d==='koy-kahvaltisi'){%>text-amber-700<%}
          else if(d==='bistro-editoryal'){%>text-zinc-900<%}
          else{%>text-sky-600<%}%>">₺<%= urun.price %></span>
      </div>

      <!-- Etiketler -->
      <% if(urun.etiketler && urun.etiketler.length){ %>
      <div class="flex flex-wrap gap-2">
        <% urun.etiketler.forEach(function(e){ %>
        <span class="text-xs px-2.5 py-1 rounded-full
          <% if(isDark){%>bg-slate-800 text-slate-300<%}else{%>bg-slate-100 text-slate-600<%}%>"><%= e %></span>
        <% }); %>
      </div>
      <% } %>

      <!-- Açıklama -->
      <p class="leading-relaxed <% if(isDark){%>text-slate-300<%}else if(d==='koy-kahvaltisi'){%>text-stone-500<%}else{%>text-slate-600<%}%>"><%= urun.description %></p>

      <!-- Butonlar -->
      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <a href="<%= onizlemeBase %>/k/<%= kat.slug||kat.id %>"
           class="flex-1 text-center py-3 rounded-xl font-semibold gecis text-sm
             <% if(isDark){%>bg-slate-800 text-slate-200 hover:bg-slate-700<%}
             else if(d==='koy-kahvaltisi'){%>bg-amber-100 text-amber-800 hover:bg-amber-200<%}
             else if(d==='vegan-minimal'){%>bg-green-50 text-green-700 hover:bg-green-100<%}
             else{%>bg-slate-100 text-slate-700 hover:bg-slate-200<%}%>">
          ← Kategoriye Dön
        </a>
        <a href="/temalar/<%= tema.slug %>"
           class="flex-1 text-center py-3 rounded-xl font-bold gecis text-sm text-white
             <% if(d==='premium-koyu'){%>bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500<%}
             else if(d==='sushi-kartlar'){%>bg-indigo-600 hover:bg-indigo-500<%}
             else if(d==='gece-modu'){%>bg-cyan-600 hover:bg-cyan-500<%}
             else if(d==='premium'){%>bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500<%}
             else if(d==='vegan-minimal'){%>bg-green-600 hover:bg-green-500<%}
             else if(d==='koy-kahvaltisi'){%>bg-amber-600 hover:bg-amber-500<%}
             else if(d==='bistro-editoryal'){%>bg-zinc-900 hover:bg-zinc-700<%}
             else{%>bg-sky-600 hover:bg-sky-500<%}%>">
          Bu Temayı Satın Al
        </a>
      </div>

      <!-- Menü bilgisi -->
      <div class="pt-3 border-t <% if(isDark){%>border-slate-800<%}else{%>border-slate-100<%}%>">
        <p class="text-xs <% if(koyu){%>text-slate-500<%}else{%>text-slate-400<%}%>">🍽 <%= menu.businessName %> · Demo Önizleme</p>
      </div>
    </div>
  </div>

  <!-- İlgili Ürünler -->
  <% if(kategoriUrunleri && kategoriUrunleri.length){ %>
  <section class="mt-14">
    <h2 class="text-lg font-bold mb-5 <% if(isDark){%>text-white<%}else{%>text-slate-800<%}%>">
      <%= kat.emoji %> <%= kat.name %> kategorisinden diğerleri
    </h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
      <% kategoriUrunleri.forEach(function(r){ %>
      <a href="<%= onizlemeBase %>/u/<%= r.slug %>"
         class="group rounded-xl overflow-hidden gecis
           <% if(isDark){%>bg-slate-900 border border-slate-800 hover:border-slate-600<%}else{%>bg-white border border-slate-100 hover:shadow-md<%}%>">
        <div class="h-28 bg-slate-100 overflow-hidden">
          <% if(r.imageUrl){ %>
          <img src="<%= r.imageUrl %>" alt="<%= r.name %>" class="w-full h-full object-cover group-hover:scale-105 gecis"/>
          <% }else{ %>
          <div class="w-full h-full flex items-center justify-center text-3xl"><%= kat.emoji %></div>
          <% } %>
        </div>
        <div class="p-3">
          <p class="font-semibold text-sm truncate <% if(isDark){%>text-white<%}else{%>text-slate-800<%}%>"><%= r.name %></p>
          <p class="font-bold text-sm <% if(isDark){%>text-slate-300<%}else{%>text-slate-600<%}%>">₺<%= r.price %></p>
        </div>
      </a>
      <% }); %>
    </div>
  </section>
  <% } %>
</main>
</body>
</html>
