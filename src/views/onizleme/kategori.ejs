<%
var d = konfig.duzen;
var koyu = konfig.koyuMod;
var onizlemeBase = '/onizleme/' + tema.slug;
var isDark = (d==='sushi-kartlar'||d==='premium-koyu'||d==='gece-modu'||d==='premium');
%><!DOCTYPE html>
<html lang="tr" class="scroll-smooth">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= kategori.name %> — <%= menu.businessName %> Önizleme</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet"/>
  <style>body{font-family:'Inter',system-ui,sans-serif;}.gecis{transition:all .2s ease;}.no-scrollbar::-webkit-scrollbar{display:none;}.no-scrollbar{-ms-overflow-style:none;scrollbar-width:none;}.glass{background:rgba(255,255,255,.08);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.12);}</style>
</head>
<body class="min-h-screen <% if(isDark){%>bg-slate-900 text-white<%}else if(d==='vegan-minimal'){%>bg-white text-zinc-800<%}else if(d==='bistro-editoryal'){%>bg-white text-zinc-900<%}else if(d==='koy-kahvaltisi'){%>bg-amber-50 text-stone-800<%}else{%>bg-slate-50 text-slate-800<%}%>">

<!-- Önizleme bandı -->
<div class="sticky top-0 z-[60] bg-amber-400 text-amber-950 text-xs font-bold flex items-center justify-between px-4 py-2.5">
  <span>👀 ÖNİZLEME</span>
  <a href="/temalar/<%= tema.slug %>" class="bg-amber-900 text-amber-50 px-3 py-1 rounded-full text-xs hover:bg-amber-800 gecis">Satın Al →</a>
</div>

<!-- Header -->
<header class="sticky top-8 z-50 border-b shadow-sm
  <% if(d==='premium-koyu'){%>bg-[#070714]/90 border-purple-900/20<%}else if(d==='sushi-kartlar'){%>bg-slate-950 border-slate-800<%}else if(d==='gece-modu'||d==='premium'){%>bg-slate-950 border-slate-800<%}else if(d==='vegan-minimal'){%>bg-white border-green-100<%}else if(d==='bistro-editoryal'){%>bg-white border-zinc-200<%}else if(d==='koy-kahvaltisi'){%>bg-white border-amber-100<%}else{%>bg-white border-slate-200<%}%>">
  <div class="max-w-5xl mx-auto px-4 h-13 flex items-center gap-3 py-2">
    <a href="<%= onizlemeBase %>" class="<% if(koyu){%>text-slate-400 hover:text-white<%}else{%>text-slate-400 hover:text-slate-700<%}%> gecis text-sm">← Menü</a>
    <span class="<% if(koyu){%>text-slate-600<%}else{%>text-slate-200<%}%>">/</span>
    <span class="font-semibold text-sm <% if(koyu){%>text-white<%}%>"><%= kategori.name %></span>
  </div>
  <!-- Kategori seçici şeridi -->
  <div class="max-w-5xl mx-auto px-4 pb-2">
    <div class="flex gap-2 overflow-x-auto no-scrollbar">
      <% kategoriler.forEach(function(k){ %>
      <a href="<%= onizlemeBase %>/k/<%= k.slug || k.id %>"
         class="shrink-0 flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold gecis
           <% if(k.id===kategori.id){
             if(d==='premium-koyu'){%>bg-purple-600 text-white<%}
             else if(d==='sushi-kartlar'){%>bg-indigo-600 text-white<%}
             else if(d==='gece-modu'){%>bg-cyan-500 text-white<%}
             else if(d==='premium'){%>bg-purple-600 text-white<%}
             else if(d==='vegan-minimal'){%>bg-green-600 text-white<%}
             else if(d==='bistro-editoryal'){%>bg-zinc-900 text-white<%}
             else if(d==='koy-kahvaltisi'){%>bg-amber-600 text-white<%}
             else{%>bg-sky-600 text-white<%}
           }else{
             if(isDark){%>text-slate-400 hover:text-slate-200 hover:bg-slate-800<%}
             else{%>text-slate-600 hover:bg-slate-100<%}} %>">
        <span><%= k.emoji %></span><span><%= k.name %></span>
      </a>
      <% }); %>
    </div>
  </div>
</header>

<!-- Kategori hero -->
<div class="py-8 text-center
  <% if(d==='premium-koyu'){%>bg-[#0d0724] border-b border-purple-900/20<%}
  else if(d==='sushi-kartlar'){%>bg-slate-900 border-b border-slate-800<%}
  else if(d==='gece-modu'){%>bg-slate-900 border-b border-slate-800<%}
  else if(d==='premium'){%>bg-gradient-to-r from-purple-950 to-indigo-950 border-b border-purple-900/30<%}
  else if(d==='vegan-minimal'){%>bg-green-50 border-b border-green-100<%}
  else if(d==='koy-kahvaltisi'){%>bg-gradient-to-br from-amber-500 to-amber-600 text-white<%}
  else if(d==='bistro-editoryal'){%>bg-white border-b border-zinc-900<%}
  else if(d==='modern-galeri'){%>bg-gradient-to-r from-sky-600 to-sky-700 text-white<%}
  else{%>bg-white border-b border-slate-100<%}%>">
  <span class="text-5xl block mb-2"><%= kategori.emoji %></span>
  <h1 class="text-2xl font-bold
    <% if(d==='bistro-editoryal'){%>font-['Playfair_Display',serif] text-zinc-900<%}
    else if(d==='koy-kahvaltisi'){%>font-['Playfair_Display',serif] text-white<%}
    else if(isDark){%>text-white<%}else{%>text-slate-900<%}%>"><%= kategori.name %></h1>
  <p class="text-sm mt-1 <% if(isDark){%>text-slate-400<%}else if(d==='koy-kahvaltisi'||d==='modern-galeri'){%>text-white/80<%}else{%>text-slate-400<%}%>">
    <%= urunler.length %> ürün bulundu
  </p>
</div>

<!-- Ürünler -->
<main class="max-w-5xl mx-auto px-4 py-8">

  <% if(d==='vegan-minimal'){ %>
  <!-- VEGAN MİNİMAL: yuvarlak thumbnails, liste -->
  <div class="space-y-5 max-w-2xl mx-auto">
    <% urunler.forEach(function(u){ %>
    <a href="<%= onizlemeBase %>/u/<%= u.slug %>" class="flex items-center gap-5 group">
      <% if(u.imageUrl){ %><img src="<%= u.imageUrl %>" alt="" class="w-16 h-16 object-cover rounded-full shrink-0 ring-2 ring-green-100 group-hover:ring-green-300 gecis"/>
      <% }else{ %><div class="w-16 h-16 rounded-full bg-green-50 flex items-center justify-center text-2xl shrink-0 ring-2 ring-green-100"><%= kategori.emoji %></div><% } %>
      <div class="flex-1 border-b border-zinc-100 pb-5">
        <div class="flex justify-between">
          <p class="font-semibold text-zinc-800 group-hover:text-green-700 gecis"><%= u.name %></p>
          <span class="text-green-600 font-bold ml-4">₺<%= u.price %></span>
        </div>
        <p class="text-zinc-400 text-xs mt-1 leading-relaxed"><%= u.description %></p>
      </div>
    </a>
    <% }); %>
  </div>

  <% } else if(d==='bistro-editoryal'){ %>
  <!-- BİSTRO EDİTORYAL: yoğun satır listesi -->
  <div class="max-w-4xl mx-auto">
    <% urunler.forEach(function(u){ %>
    <a href="<%= onizlemeBase %>/u/<%= u.slug %>" class="flex items-center py-3 border-b border-zinc-100 hover:bg-zinc-50 gecis group px-2 -mx-2">
      <% if(u.imageUrl){ %><img src="<%= u.imageUrl %>" alt="" class="w-10 h-10 object-cover rounded shrink-0 mr-3 opacity-80 group-hover:opacity-100 gecis"/>
      <% }else{ %><span class="w-10 h-10 mr-3 flex items-center justify-center text-zinc-200 text-lg shrink-0"><%= kategori.emoji %></span><% } %>
      <div class="flex-1 min-w-0">
        <p class="font-semibold text-zinc-900 text-sm"><%= u.name %></p>
        <p class="text-zinc-400 text-xs truncate"><%= u.description %></p>
      </div>
      <div class="flex items-center gap-1.5 ml-3 shrink-0">
        <span class="border-b border-dotted border-zinc-300 w-8 hidden sm:block"></span>
        <span class="font-bold text-zinc-900 text-sm w-16 text-right">₺<%= u.price %></span>
      </div>
    </a>
    <% }); %>
  </div>

  <% } else if(d==='koy-kahvaltisi'){ %>
  <!-- KÖY KAHVALTISI: görsel sol + içerik sağ -->
  <div class="space-y-3 max-w-3xl mx-auto">
    <% urunler.forEach(function(u){ %>
    <a href="<%= onizlemeBase %>/u/<%= u.slug %>" class="flex gap-4 p-3 bg-white rounded-2xl border border-amber-100 hover:border-amber-300 hover:shadow-md gecis group">
      <% if(u.imageUrl){ %><img src="<%= u.imageUrl %>" alt="" class="w-24 h-24 object-cover rounded-xl shrink-0"/>
      <% }else{ %><div class="w-24 h-24 bg-amber-50 rounded-xl flex items-center justify-center text-3xl shrink-0"><%= kategori.emoji %></div><% } %>
      <div class="flex-1 min-w-0 flex flex-col justify-center">
        <p class="font-semibold text-stone-800 group-hover:text-amber-800 gecis"><%= u.name %></p>
        <p class="text-stone-400 text-xs mt-1 leading-relaxed line-clamp-2"><%= u.description %></p>
        <span class="font-bold text-amber-700 text-sm mt-2">₺<%= u.price %></span>
      </div>
    </a>
    <% }); %>
  </div>

  <% } else if(isDark){ %>
  <!-- DARK TEMALAR (sushi-kartlar, premium-koyu...): cam kartlar -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% urunler.forEach(function(u){ %>
    <a href="<%= onizlemeBase %>/u/<%= u.slug %>"
       class="group rounded-xl overflow-hidden gecis flex flex-col
         <% if(d==='premium-koyu'){%>bg-white/5 border border-white/10 hover:border-purple-500/30 backdrop-blur-lg<%}else{%>bg-slate-800/60 border border-slate-700/50 hover:border-indigo-500/50<%}%>">
      <% if(u.imageUrl){ %>
      <div class="h-40 overflow-hidden relative">
        <img src="<%= u.imageUrl %>" alt="" class="w-full h-full object-cover opacity-70 group-hover:opacity-90 gecis group-hover:scale-105"/>
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
      </div>
      <% } %>
      <div class="p-4 flex-1 flex flex-col">
        <p class="font-bold text-white mb-1"><%= u.name %></p>
        <p class="text-slate-400 text-xs line-clamp-2 flex-1"><%= u.description %></p>
        <span class="<% if(d==='premium-koyu'){%>text-transparent bg-gradient-to-r from-purple-300 to-pink-300 bg-clip-text<%}else{%>text-indigo-400<%}%> font-black text-sm mt-3 block">₺<%= u.price %></span>
      </div>
    </a>
    <% }); %>
  </div>

  <% } else { %>
  <!-- VARSAYILAN (modern-galeri): galeri grid -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
    <% urunler.forEach(function(u,ui){ %>
    <a href="<%= onizlemeBase %>/u/<%= u.slug %>"
       class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg gecis border border-slate-100 flex flex-col
         <%= ui===0 ? 'sm:col-span-2' : '' %>">
      <div class="overflow-hidden" style="height:<%= ui===0?'180px':'130px' %>">
        <% if(u.imageUrl){ %><img src="<%= u.imageUrl %>" alt="<%= u.name %>" class="w-full h-full object-cover group-hover:scale-105 gecis"/>
        <% }else{ %><div class="w-full h-full bg-sky-50 flex items-center justify-center text-3xl"><%= kategori.emoji %></div><% } %>
      </div>
      <div class="p-3 flex-1 flex flex-col">
        <p class="font-semibold text-slate-800 text-sm truncate"><%= u.name %></p>
        <p class="text-xs text-slate-400 line-clamp-1"><%= u.description %></p>
        <div class="flex justify-between items-center mt-2">
          <span class="font-black text-sky-600 text-sm">₺<%= u.price %></span>
          <span class="text-[10px] text-slate-400 group-hover:text-sky-500 gecis">detay →</span>
        </div>
      </div>
    </a>
    <% }); %>
  </div>
  <% } %>

</main>
</body>
</html>
