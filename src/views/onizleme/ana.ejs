<%
// ─── Tema konfigürasyonu kısaltmaları ──────────────────────────────────────
var d = konfig.duzen;
var koyu = konfig.koyuMod;
// Renk tokenleri
var renkler = {
  'koy-kahvaltisi':   { vurgu:'amber',  bg:'amber-50',  yazi:'stone-800',  kart:'white' },
  'vegan-minimal':    { vurgu:'green',  bg:'white',     yazi:'zinc-800',   kart:'white' },
  'sushi-kartlar':    { vurgu:'indigo', bg:'slate-900', yazi:'white',      kart:'slate-800' },
  'premium-koyu':     { vurgu:'purple', bg:'#070714',   yazi:'white',      kart:'transparent' },
  'bistro-editoryal': { vurgu:'zinc',   bg:'white',     yazi:'zinc-900',   kart:'white' },
  'modern-galeri':    { vurgu:'sky',    bg:'slate-50',  yazi:'slate-800',  kart:'white' },
  // Legacy
  'klasik-liste':    { vurgu:'indigo', bg:'slate-50', yazi:'slate-800', kart:'white' },
  'kart-duzen':      { vurgu:'violet', bg:'violet-50', yazi:'slate-900', kart:'white' },
  'gece-modu':       { vurgu:'cyan',   bg:'slate-950', yazi:'white',     kart:'slate-900' },
  'premium':         { vurgu:'purple', bg:'slate-950', yazi:'white',     kart:'slate-900' },
}[d] || { vurgu:'amber', bg:'amber-50', yazi:'stone-800', kart:'white' };
%><!DOCTYPE html>
<html lang="tr" class="scroll-smooth">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= baslik %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet"/>
  <style>
    body{font-family:'Inter',system-ui,sans-serif;} .gecis{transition:all .2s ease;}
    .no-scrollbar::-webkit-scrollbar{display:none;} .no-scrollbar{-ms-overflow-style:none;scrollbar-width:none;}
    @keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
    .fade-up{animation:fadeUp .4s ease both;}
    .glass{background:rgba(255,255,255,.08);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.12);}
    .glass-dark{background:rgba(0,0,0,.3);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.08);}
  </style>
</head>
<body class="min-h-screen
  <% if(d==='sushi-kartlar'){%>bg-slate-900 text-white<%}else if(d==='premium-koyu'){%>bg-[#070714] text-white<%}else if(d==='vegan-minimal'){%>bg-white text-zinc-800<%}else if(d==='bistro-editoryal'){%>bg-white text-zinc-900<%}else if(d==='modern-galeri'){%>bg-slate-50 text-slate-800<%}else if(d==='gece-modu'||d==='premium'){%>bg-slate-950 text-white<%}else{%>bg-amber-50 text-stone-800<%}%>">

<!-- ── ÖNIZLEME BANTI ────────────────────────────────────────────────────── -->
<div class="sticky top-0 z-[60] bg-amber-400 text-amber-950 text-xs font-bold flex items-center justify-between px-4 py-2.5 shadow-sm">
  <span>👀 ÖNİZLEME — Demo içerik gösteriliyor, gerçek menü değil.</span>
  <a href="/temalar/<%= tema.slug %>" class="bg-amber-900 text-amber-50 px-3 py-1 rounded-full text-xs hover:bg-amber-800 gecis">
    ₺<%= Number(tema.price).toFixed(0) %> Satın Al →
  </a>
</div>

<!-- ══════════════════════════════════════════════════════════════════════════
 1. KLASİK LİSTE
══════════════════════════════════════════════════════════════════════════════ -->
<%# ══════════════════════════════════════════════════════════════════════════
   YENİ 6 TEMA — tema_01 … tema_06
══════════════════════════════════════════════════════════════════════════ %>

<!-- ═══════════════════════════════════════════════════════════════════════
   1. KÖY KAHVALTISI — Amber/taş, rustik, serif tipografi
═══════════════════════════════════════════════════════════════════════════ -->
<% if (d === 'koy-kahvaltisi') { %>

<header class="bg-white/90 backdrop-blur border-b border-amber-100 sticky top-8 z-50">
  <div class="max-w-3xl mx-auto px-4 h-14 flex items-center justify-between">
    <span class="font-['Playfair_Display',serif] text-amber-800 font-bold text-base">🌾 <%= menu.businessName %></span>
    <nav class="hidden sm:flex gap-4 text-xs text-stone-500">
      <% kategoriler.forEach(function(k){ %>
      <a href="#kat-<%= k.id %>" class="hover:text-amber-700 gecis"><%= k.emoji %> <%= k.name %></a>
      <% }); %>
    </nav>
  </div>
</header>

<div class="bg-gradient-to-br from-amber-600 to-amber-700 text-white py-14 text-center">
  <p class="text-amber-200 text-[11px] tracking-[0.3em] uppercase mb-3">🌾 geleneksel lezzetler</p>
  <h1 class="font-['Playfair_Display',serif] text-5xl font-bold mb-3"><%= menu.businessName %></h1>
  <div class="w-16 h-0.5 bg-amber-300 mx-auto mb-3"></div>
  <p class="text-amber-100 text-sm"><%= menu.aciklama %></p>
</div>

<main class="max-w-3xl mx-auto px-4 py-10">
  <% kategoriler.forEach(function(kat){ var urunler = urunlerKategoriye[kat.id]||[]; %>
  <section id="kat-<%= kat.id %>" class="mb-14">
    <!-- Kategori başlık -->
    <div class="flex items-center gap-4 mb-6">
      <div class="text-3xl"><%= kat.emoji %></div>
      <div class="flex-1">
        <h2 class="font-['Playfair_Display',serif] text-2xl font-bold text-amber-900"><%= kat.name %></h2>
        <div class="h-0.5 bg-gradient-to-r from-amber-400 to-transparent mt-1"></div>
      </div>
      <span class="text-xs text-stone-400 bg-amber-50 px-2 py-0.5 rounded-full"><%= urunler.length %> ürün</span>
    </div>
    <!-- Ürün listesi: görsel sol + içerik sağ -->
    <div class="space-y-3">
      <% urunler.forEach(function(u){ %>
      <a href="<%= baseUrl %>/u/<%= u.slug %>"
         class="flex gap-4 p-3 bg-white rounded-2xl border border-amber-100 hover:border-amber-300 hover:shadow-md gecis group">
        <% if(u.imageUrl){ %>
        <img src="<%= u.imageUrl %>" alt="<%= u.name %>" class="w-24 h-24 object-cover rounded-xl shrink-0"/>
        <% }else{ %>
        <div class="w-24 h-24 bg-amber-50 rounded-xl flex items-center justify-center text-3xl shrink-0"><%= kat.emoji %></div>
        <% } %>
        <div class="flex-1 min-w-0 flex flex-col justify-center">
          <p class="font-semibold text-stone-800 text-sm group-hover:text-amber-800 gecis"><%= u.name %></p>
          <p class="text-stone-400 text-xs line-clamp-2 mt-1 leading-relaxed"><%= u.description %></p>
          <div class="flex items-center justify-between mt-2">
            <% if(u.etiketler&&u.etiketler.length){ %>
            <span class="text-[10px] bg-amber-50 text-amber-700 px-1.5 py-0.5 rounded"><%= u.etiketler[0] %></span>
            <% }else{ %><span></span><% } %>
            <span class="font-bold text-amber-700 text-sm">₺<%= u.price %></span>
          </div>
        </div>
      </a>
      <% }); %>
    </div>
  </section>
  <% }); %>
</main>

<!-- ═══════════════════════════════════════════════════════════════════════
   2. VEGAN MİNİMAL — Beyaz/yeşil, yuvarlak görseller, bol boşluk
═══════════════════════════════════════════════════════════════════════════ -->
<% } else if (d === 'vegan-minimal') { %>

<header class="bg-white border-b border-green-100 sticky top-8 z-50">
  <div class="max-w-2xl mx-auto px-6 h-14 flex items-center justify-between">
    <span class="text-green-700 font-semibold tracking-tight">🌿 <%= menu.businessName %></span>
    <div class="flex gap-2 overflow-x-auto no-scrollbar">
      <% kategoriler.forEach(function(k){ %>
      <a href="#vm-<%= k.id %>" class="shrink-0 px-3 py-1 rounded-full text-xs font-medium text-green-700 bg-green-50 hover:bg-green-100 gecis"><%= k.name %></a>
      <% }); %>
    </div>
  </div>
</header>

<div class="max-w-2xl mx-auto px-6 pt-16 pb-8">
  <p class="text-green-400 text-[10px] tracking-[0.4em] uppercase mb-4">organik · doğal · taze</p>
  <h1 class="text-5xl font-bold text-zinc-800 mb-2 leading-none"><%= menu.businessName %></h1>
  <div class="w-12 h-1 bg-green-500 rounded-full mb-3"></div>
  <p class="text-zinc-400 text-sm"><%= menu.aciklama %></p>
</div>

<main class="max-w-2xl mx-auto px-6 pb-20">
  <% kategoriler.forEach(function(kat){ var urunler = urunlerKategoriye[kat.id]||[]; %>
  <section id="vm-<%= kat.id %>" class="mb-16">
    <div class="flex items-center gap-3 mb-6 pt-8 border-t border-green-100">
      <span class="text-2xl"><%= kat.emoji %></span>
      <h2 class="text-xl font-bold text-zinc-700"><%= kat.name %></h2>
      <span class="ml-auto text-xs text-green-400"><%= urunler.length %> seçenek</span>
    </div>
    <div class="space-y-5">
      <% urunler.forEach(function(u){ %>
      <a href="<%= baseUrl %>/u/<%= u.slug %>" class="flex items-center gap-5 group">
        <% if(u.imageUrl){ %>
        <img src="<%= u.imageUrl %>" alt="<%= u.name %>" class="w-16 h-16 object-cover rounded-full shrink-0 ring-2 ring-green-100 group-hover:ring-green-300 gecis"/>
        <% }else{ %>
        <div class="w-16 h-16 rounded-full bg-green-50 flex items-center justify-center text-2xl shrink-0 ring-2 ring-green-100"><%= kat.emoji %></div>
        <% } %>
        <div class="flex-1 border-b border-zinc-100 pb-5">
          <div class="flex justify-between items-start">
            <p class="font-semibold text-zinc-800 group-hover:text-green-700 gecis"><%= u.name %></p>
            <span class="text-green-600 font-bold ml-4 shrink-0">₺<%= u.price %></span>
          </div>
          <p class="text-zinc-400 text-xs mt-1 leading-relaxed"><%= u.description %></p>
        </div>
      </a>
      <% }); %>
    </div>
  </section>
  <% }); %>
</main>

<!-- ═══════════════════════════════════════════════════════════════════════
   3. SUSHİ KARTLAR — Koyu slate, indigo aksanlar, 2 sütun grid
═══════════════════════════════════════════════════════════════════════════ -->
<% } else if (d === 'sushi-kartlar') { %>

<header class="bg-slate-950 border-b border-slate-800 sticky top-8 z-50">
  <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
    <span class="font-bold text-white tracking-wide">⬡ <%= menu.businessName %></span>
    <div class="flex gap-3 text-slate-400 text-xs">
      <% kategoriler.forEach(function(k){ %>
      <a href="#sk-<%= k.id %>" class="hover:text-indigo-400 gecis hidden sm:block"><%= k.name %></a>
      <% }); %>
    </div>
  </div>
</header>

<div class="relative bg-slate-900 border-b border-slate-800 py-14 overflow-hidden">
  <div class="absolute inset-0" style="background:repeating-linear-gradient(0deg,rgba(99,102,241,.03) 0px,rgba(99,102,241,.03) 1px,transparent 1px,transparent 40px),repeating-linear-gradient(90deg,rgba(99,102,241,.03) 0px,rgba(99,102,241,.03) 1px,transparent 1px,transparent 40px)"></div>
  <div class="relative max-w-5xl mx-auto px-4">
    <p class="text-indigo-400 text-[10px] tracking-[0.4em] uppercase mb-3">● dijital menü</p>
    <h1 class="text-4xl font-black text-white mb-2"><%= menu.businessName %></h1>
    <div class="w-20 h-0.5 bg-indigo-500 mb-3"></div>
    <p class="text-slate-400 text-sm"><%= menu.aciklama %></p>
  </div>
</div>

<main class="max-w-5xl mx-auto px-4 py-10 space-y-14">
  <% kategoriler.forEach(function(kat){ var urunler = urunlerKategoriye[kat.id]||[]; %>
  <section id="sk-<%= kat.id %>">
    <div class="flex items-center gap-3 mb-6">
      <span class="text-xl"><%= kat.emoji %></span>
      <h2 class="text-base font-bold text-indigo-400 tracking-wider uppercase"><%= kat.name %></h2>
      <div class="flex-1 h-px bg-slate-800"></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <% urunler.forEach(function(u){ %>
      <a href="<%= baseUrl %>/u/<%= u.slug %>"
         class="group flex gap-0 bg-slate-800/60 border border-slate-700/50 hover:border-indigo-500/50 rounded-xl overflow-hidden gecis">
        <% if(u.imageUrl){ %>
        <div class="w-28 shrink-0 overflow-hidden">
          <img src="<%= u.imageUrl %>" alt="<%= u.name %>" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 gecis group-hover:scale-105"/>
        </div>
        <% }else{ %>
        <div class="w-28 shrink-0 bg-slate-700 flex items-center justify-center text-2xl"><%= kat.emoji %></div>
        <% } %>
        <div class="flex-1 p-4 flex flex-col justify-between">
          <div>
            <p class="font-semibold text-white text-sm"><%= u.name %></p>
            <p class="text-slate-400 text-xs mt-1 line-clamp-2"><%= u.description %></p>
          </div>
          <div class="flex justify-between items-center mt-2">
            <span class="text-indigo-400 font-black text-base">₺<%= u.price %></span>
            <span class="text-[10px] text-slate-600 group-hover:text-indigo-400 gecis">detay →</span>
          </div>
        </div>
      </a>
      <% }); %>
    </div>
  </section>
  <% }); %>
</main>

<!-- ═══════════════════════════════════════════════════════════════════════
   4. PREMİUM KOYU — Glassmorphism, mor gradient, lüks
═══════════════════════════════════════════════════════════════════════════ -->
<% } else if (d === 'premium-koyu') { %>

<style>
  @keyframes glow{0%,100%{box-shadow:0 0 20px rgba(168,85,247,.0)}50%{box-shadow:0 0 40px rgba(168,85,247,.2)}}
  .card-glow:hover{animation:glow 2s ease-in-out infinite;}
  .glass-card{background:rgba(255,255,255,.04);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.07);}
  .grad-text{background:linear-gradient(135deg,#c084fc,#f472b6,#818cf8);-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
</style>

<header class="sticky top-8 z-50" style="background:rgba(7,7,20,.85);backdrop-filter:blur(20px);border-bottom:1px solid rgba(168,85,247,.15)">
  <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between">
    <span class="font-black text-lg grad-text">✦ <%= menu.businessName %></span>
    <div class="flex gap-4 text-sm">
      <% kategoriler.forEach(function(k){ %>
      <a href="#pk-<%= k.id %>" class="text-purple-400/60 hover:text-purple-300 gecis text-xs hidden sm:block"><%= k.name %></a>
      <% }); %>
    </div>
  </div>
</header>

<div class="relative py-24 text-white text-center overflow-hidden" style="background:linear-gradient(135deg,#070714 0%,#150a2e 50%,#070714 100%)">
  <div class="absolute inset-0" style="background:radial-gradient(ellipse 120% 80% at 50% 50%,rgba(139,92,246,.12) 0%,transparent 70%)"></div>
  <div class="absolute top-8 left-1/2 -translate-x-1/2 w-96 h-96 rounded-full" style="background:radial-gradient(circle,rgba(168,85,247,.06) 0%,transparent 70%)"></div>
  <div class="relative">
    <div class="w-12 h-12 mx-auto mb-6 rounded-full flex items-center justify-center" style="background:rgba(168,85,247,.15);border:1px solid rgba(168,85,247,.3)">✦</div>
    <h1 class="text-5xl font-black mb-3 grad-text leading-tight"><%= menu.businessName %></h1>
    <p class="text-purple-300/60 text-sm tracking-widest uppercase"><%= menu.aciklama %></p>
  </div>
</div>

<main class="max-w-6xl mx-auto px-4 py-14 space-y-16" style="background:linear-gradient(180deg,#070714 0%,#0d0724 100%)">
  <% kategoriler.forEach(function(kat){ var urunler = urunlerKategoriye[kat.id]||[]; %>
  <section id="pk-<%= kat.id %>">
    <div class="flex items-center gap-4 mb-8">
      <span class="text-2xl"><%= kat.emoji %></span>
      <h2 class="text-sm font-bold text-purple-400 tracking-[0.3em] uppercase"><%= kat.name %></h2>
      <div class="flex-1 h-px" style="background:linear-gradient(to right,rgba(168,85,247,.3),transparent)"></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% urunler.forEach(function(u){ %>
      <a href="<%= baseUrl %>/u/<%= u.slug %>"
         class="group glass-card card-glow rounded-2xl overflow-hidden gecis flex flex-col">
        <% if(u.imageUrl){ %>
        <div class="h-44 overflow-hidden relative">
          <img src="<%= u.imageUrl %>" alt="<%= u.name %>" class="w-full h-full object-cover opacity-50 group-hover:opacity-75 gecis group-hover:scale-105"/>
          <div class="absolute inset-0" style="background:linear-gradient(to top,rgba(7,7,20,.9) 0%,transparent 60%)"></div>
        </div>
        <% }else{ %>
        <div class="h-44" style="background:linear-gradient(135deg,rgba(168,85,247,.1),rgba(244,114,182,.05))"></div>
        <% } %>
        <div class="p-4 flex-1 flex flex-col">
          <p class="font-bold text-white mb-1.5 group-hover:text-purple-200 gecis"><%= u.name %></p>
          <p class="text-purple-300/50 text-xs line-clamp-2 flex-1"><%= u.description %></p>
          <div class="flex items-center justify-between mt-3 pt-3" style="border-top:1px solid rgba(168,85,247,.1)">
            <span class="font-black text-sm grad-text">₺<%= u.price %></span>
            <span class="text-[10px] text-purple-600 group-hover:text-purple-300 gecis">✦ incele</span>
          </div>
        </div>
      </a>
      <% }); %>
    </div>
  </section>
  <% }); %>
</main>

<!-- ═══════════════════════════════════════════════════════════════════════
   5. BİSTRO EDİTORYAL — Siyah/beyaz serif, gazete stili, sağda fiyat
═══════════════════════════════════════════════════════════════════════════ -->
<% } else if (d === 'bistro-editoryal') { %>

<header class="bg-white border-b-2 border-zinc-900 sticky top-8 z-50">
  <div class="max-w-4xl mx-auto px-4 h-14 flex items-center justify-between">
    <span class="font-['Playfair_Display',serif] text-zinc-900 font-bold text-lg"><%= menu.businessName %></span>
    <div class="flex gap-1 text-xs text-zinc-400">
      <% kategoriler.forEach(function(k,i){ %>
      <% if(i>0){%><span class="text-zinc-200">·</span><% } %>
      <a href="#be-<%= k.id %>" class="hover:text-zinc-900 gecis"><%= k.name %></a>
      <% }); %>
    </div>
  </div>
</header>

<!-- Hero mashead -->
<div class="border-b-4 border-double border-zinc-200 py-8 text-center bg-white">
  <p class="text-[10px] tracking-[0.4em] text-zinc-300 uppercase mb-2">dijital menü · yemek seçkisi</p>
  <h1 class="font-['Playfair_Display',serif] text-6xl font-bold text-zinc-900 leading-none mb-2"><%= menu.businessName %></h1>
  <div class="flex items-center justify-center gap-3 text-zinc-200 text-xs">
    <span class="h-px w-12 bg-zinc-200 block"></span>
    <span class="text-zinc-400 italic"><%= menu.aciklama %></span>
    <span class="h-px w-12 bg-zinc-200 block"></span>
  </div>
</div>

<main class="max-w-4xl mx-auto px-4 py-8">
  <% kategoriler.forEach(function(kat, ki){ var urunler = urunlerKategoriye[kat.id]||[]; %>
  <section id="be-<%= kat.id %>" class="mb-10">
    <!-- Kategori başlık: büyük numara + isim -->
    <div class="flex items-end gap-4 border-b border-zinc-900 pb-2 mb-0">
      <span class="font-['Playfair_Display',serif] text-7xl font-bold text-zinc-100 leading-none"><%- String(ki+1).padStart(2,'0') %></span>
      <div class="pb-1">
        <p class="text-[10px] tracking-widest text-zinc-300 uppercase"><%= kat.emoji %></p>
        <h2 class="font-['Playfair_Display',serif] text-2xl font-bold text-zinc-900"><%= kat.name %></h2>
      </div>
      <span class="ml-auto pb-1 text-xs text-zinc-400"><%= urunler.length %> ürün</span>
    </div>
    <!-- Dense ürün satırları -->
    <div>
      <% urunler.forEach(function(u){ %>
      <a href="<%= baseUrl %>/u/<%= u.slug %>"
         class="flex items-center py-3 border-b border-zinc-100 hover:bg-zinc-50 gecis group px-2 -mx-2">
        <% if(u.imageUrl){ %>
        <img src="<%= u.imageUrl %>" alt="<%= u.name %>" class="w-10 h-10 object-cover rounded shrink-0 mr-3 opacity-80 group-hover:opacity-100 gecis"/>
        <% }else{ %>
        <span class="w-10 h-10 mr-3 flex items-center justify-center text-zinc-200 text-lg shrink-0"><%= kat.emoji %></span>
        <% } %>
        <div class="flex-1 min-w-0">
          <p class="font-semibold text-zinc-900 text-sm"><%= u.name %></p>
          <p class="text-zinc-400 text-xs truncate"><%= u.description %></p>
        </div>
        <!-- Noktalı çizgi ve fiyat -->
        <div class="flex items-center gap-1.5 ml-3 shrink-0">
          <span class="flex-1 border-b border-dotted border-zinc-300 w-8 hidden sm:block"></span>
          <span class="font-bold text-zinc-900 text-sm w-16 text-right">₺<%= u.price %></span>
        </div>
      </a>
      <% }); %>
    </div>
  </section>
  <% }); %>
</main>

<!-- ═══════════════════════════════════════════════════════════════════════
   6. MODERN GALERİ — Sky mavi, geniş hero, galeri grid
═══════════════════════════════════════════════════════════════════════════ -->
<% } else if (d === 'modern-galeri') { %>

<header class="bg-white border-b border-slate-200 sticky top-8 z-50 shadow-sm">
