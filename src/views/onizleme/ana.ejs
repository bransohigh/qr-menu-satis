<main class="max-w-5xl mx-auto px-4 py-8 space-y-12">
  <% kategoriler.forEach(function(kat){ var urunler = urunlerKategoriye[kat.id]||[]; %>
  <section id="serit-<%= kat.id %>" class="scroll-mt-28">
    <div class="flex items-center gap-2 mb-5">
      <span class="text-2xl"><%= kat.emoji %></span>
      <h2 class="text-xl font-bold text-rose-700"><%= kat.name %></h2>
      <span class="text-xs text-slate-300 font-medium">(<%= urunler.length %>)</span>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
      <% urunler.forEach(function(u){ %>
      <a href="<%= baseUrl %>/u/<%= u.slug %>"
         class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg gecis border border-rose-50">
        <div class="h-32 bg-rose-50 overflow-hidden">
          <% if(u.imageUrl){ %>
          <img src="<%= u.imageUrl %>" alt="<%= u.name %>" class="w-full h-full object-cover group-hover:scale-105 gecis"/>
          <% }else{ %>
          <div class="w-full h-full flex items-center justify-center text-3xl"><%= kat.emoji %></div>
          <% } %>
        </div>
        <div class="p-3">
          <p class="font-semibold text-slate-800 text-sm truncate"><%= u.name %></p>
          <span class="font-bold text-rose-600 text-sm">₺<%= u.price %></span>
        </div>
      </a>
      <% }); %>
    </div>
  </section>
  <% }); %>
</main>

<!-- ══════════════════════════════════════════════════════════════════════════
 8. GÖRSEL ODAKLI
══════════════════════════════════════════════════════════════════════════════ -->
<% } else if (d === 'gorsel-odakli') { %>

<header class="bg-white border-b border-slate-200 sticky top-8 z-50 shadow-sm">
  <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between">
    <span class="font-black text-orange-600">📸 <%= menu.businessName %></span>
    <div class="flex gap-2 overflow-x-auto no-scrollbar">
      <% kategoriler.forEach(function(k){ %><a href="#gorsel-<%= k.id %>" class="shrink-0 text-xs text-slate-500 hover:text-orange-600 gecis"><%= k.name %></a><% }); %>
    </div>
  </div>
</header>

<div class="bg-orange-600 text-white py-10 text-center">
  <h1 class="text-4xl font-black"><%= menu.businessName %></h1>
  <p class="text-orange-100 mt-1"><%= menu.aciklama %></p>
</div>

<main class="max-w-6xl mx-auto px-4 py-8 space-y-10">
  <% kategoriler.forEach(function(kat){ var urunler = urunlerKategoriye[kat.id]||[]; %>
  <section id="gorsel-<%= kat.id %>">
    <h2 class="text-xl font-bold text-orange-700 mb-5 border-l-4 border-orange-400 pl-3"><%= kat.emoji %> <%= kat.name %></h2>
    <!-- Görsel ağırlıklı grid: imlk ürün büyük, geri kalanlar küçük -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
      <% urunler.forEach(function(u, ui){ %>
      <a href="<%= baseUrl %>/u/<%= u.slug %>"
         class="group relative rounded-2xl overflow-hidden shadow-sm hover:shadow-xl gecis
           <%= ui===0 ? 'row-span-2 sm:col-span-2' : '' %>"
         style="min-height:<%= ui===0?'300px':'140px' %>;">
        <!-- Görsel (tam alan kaplar) -->
        <% if(u.imageUrl){ %>
        <img src="<%= u.imageUrl %>" alt="<%= u.name %>" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 gecis"/>
        <% }else{ %>
        <div class="absolute inset-0 bg-gradient-to-br from-orange-200 to-amber-300 flex items-center justify-center text-4xl"><%= kat.emoji %></div>
        <% } %>
        <!-- Alt içerik bandı -->
        <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 to-transparent p-3">
          <p class="text-white font-bold text-sm leading-tight truncate"><%= u.name %></p>
          <div class="flex justify-between items-center mt-1">
            <p class="text-white/70 text-[11px] line-clamp-1"><%= u.description.slice(0,40) %>...</p>
            <span class="text-orange-300 font-black text-sm shrink-0 ml-2">₺<%= u.price %></span>
          </div>
        </div>
      </a>
      <% }); %>
    </div>
  </section>
  <% }); %>
</main>

<!-- ══════════════════════════════════════════════════════════════════════════
 9. KOMPAKT
══════════════════════════════════════════════════════════════════════════════ -->
<% } else if (d === 'kompakt') { %>

<header class="bg-teal-900 text-white sticky top-8 z-50">
  <div class="max-w-3xl mx-auto px-4 h-12 flex items-center justify-between text-sm">
    <span class="font-bold"><%= menu.businessName %></span>
    <div class="flex gap-3 text-teal-300 text-xs">
      <% kategoriler.forEach(function(k){ %><a href="#kompakt-<%= k.id %>" class="hover:text-white gecis"><%= k.name %></a><% }); %>
    </div>
  </div>
</header>

<div class="bg-teal-800 text-white py-6 border-b border-teal-700">
  <div class="max-w-3xl mx-auto px-4">
    <h1 class="text-2xl font-black"><%= menu.businessName %></h1>
    <p class="text-teal-300 text-sm"><%= menu.aciklama %></p>
  </div>
</div>

<main class="max-w-3xl mx-auto px-4 py-6 space-y-8">
  <% kategoriler.forEach(function(kat){ var urunler = urunlerKategoriye[kat.id]||[]; %>
  <section id="kompakt-<%= kat.id %>">
    <div class="flex items-center gap-2 mb-3 pb-1 border-b-2 border-teal-200">
      <span class="text-lg"><%= kat.emoji %></span>
      <h2 class="font-bold text-teal-800"><%= kat.name %></h2>
      <span class="text-xs text-slate-400 ml-auto"><%= urunler.length %> ürün</span>
    </div>
    <div class="space-y-0">
      <% urunler.forEach(function(u){ %>
      <a href="<%= baseUrl %>/u/<%= u.slug %>"
         class="flex items-center justify-between py-2.5 border-b border-slate-100 hover:bg-teal-50 gecis px-2 -mx-2">
        <div class="flex items-center gap-2 min-w-0">
          <% if(u.imageUrl){ %>
          <img src="<%= u.imageUrl %>" alt="" class="w-8 h-8 object-cover rounded shrink-0"/>
          <% }else{ %>
          <span class="text-base shrink-0"><%= kat.emoji %></span>
          <% } %>
          <div class="min-w-0">
            <p class="text-sm font-semibold text-slate-800 truncate"><%= u.name %></p>
            <p class="text-xs text-slate-400 truncate"><%= u.description.slice(0,50) %>...</p>
          </div>
        </div>
        <span class="font-bold text-teal-700 text-sm shrink-0 ml-3">₺<%= u.price %></span>
      </a>
      <% }); %>
    </div>
  </section>
  <% }); %>
</main>

<!-- ══════════════════════════════════════════════════════════════════════════
 10. PREMİUM (Glassmorphism)
══════════════════════════════════════════════════════════════════════════════ -->
<% } else if (d === 'premium') { %>

<header class="bg-[#0a0a1a]/90 backdrop-blur border-b border-purple-900/50 sticky top-8 z-50">
  <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between">
    <span class="font-black text-transparent bg-gradient-to-r from-purple-300 to-pink-300 bg-clip-text text-lg">✦ <%= menu.businessName %></span>
    <div class="flex gap-3">
      <% kategoriler.forEach(function(k){ %><a href="#prem-<%= k.id %>" class="text-purple-400 hover:text-purple-200 text-xs gecis"><%= k.name %></a><% }); %>
    </div>
  </div>
</header>

<div class="relative bg-gradient-to-br from-[#0a0a1a] via-purple-950 to-[#0a0a1a] py-20 text-white text-center overflow-hidden">
  <div class="absolute inset-0" style="background-image:radial-gradient(circle at 50% 50%,rgba(139,92,246,.15) 0%,transparent 70%);"></div>
  <div class="relative">
    <div class="text-5xl mb-4">✦</div>
    <h1 class="text-5xl font-black bg-gradient-to-r from-purple-200 via-pink-200 to-indigo-200 bg-clip-text text-transparent mb-3"><%= menu.businessName %></h1>
    <p class="text-purple-300 text-sm tracking-widest uppercase"><%= menu.aciklama %></p>
  </div>
</div>

<main class="max-w-6xl mx-auto px-4 py-12 space-y-14" style="background:linear-gradient(180deg,#0a0a1a 0%,#100a2a 100%)">
  <% kategoriler.forEach(function(kat){ var urunler = urunlerKategoriye[kat.id]||[]; %>
  <section id="prem-<%= kat.id %>">
    <div class="flex items-center gap-3 mb-6">
      <span class="text-2xl"><%= kat.emoji %></span>
      <h2 class="text-lg font-bold text-purple-300 tracking-wider uppercase"><%= kat.name %></h2>
      <div class="flex-1 h-px bg-gradient-to-r from-purple-800 to-transparent"></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% urunler.forEach(function(u){ %>
      <a href="<%= baseUrl %>/u/<%= u.slug %>"
         class="group glass rounded-2xl overflow-hidden hover:border-purple-500/30 gecis flex flex-col fade-up">
        <% if(u.imageUrl){ %>
        <div class="h-40 overflow-hidden relative">
          <img src="<%= u.imageUrl %>" alt="<%= u.name %>" class="w-full h-full object-cover opacity-60 group-hover:opacity-80 gecis group-hover:scale-105"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
        </div>
        <% } %>
        <div class="p-4 flex-1 flex flex-col">
          <p class="font-bold text-white mb-1 group-hover:text-purple-200 gecis"><%= u.name %></p>
          <p class="text-purple-300/70 text-xs line-clamp-2 flex-1"><%= u.description %></p>
          <div class="flex justify-between items-center mt-3">
            <span class="font-black text-transparent bg-gradient-to-r from-purple-300 to-pink-300 bg-clip-text text-sm">₺<%= u.price %></span>
            <span class="text-purple-500 text-[10px] group-hover:text-purple-300 gecis">✦ incele</span>
          </div>
        </div>
      </a>
      <% }); %>
    </div>
  </section>
  <% }); %>
</main>

<% } %>

</body>
</html>
