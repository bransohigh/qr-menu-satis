    </div>
  </section>

  <!-- ── AUTH MODAL ───────────────────────────────────────────────────────── -->
  <div id="auth-modal" class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm p-8 relative">
      <button onclick="document.getElementById('auth-modal').classList.add('hidden')"
        class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 gecis">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <h3 class="text-xl font-bold text-slate-900 mb-1">Hesap Gerekli</h3>
      <p class="text-slate-500 text-sm mb-6">Satın alma için giriş yapın veya ücretsiz hesap oluşturun.</p>
      <a id="auth-modal-link" href="/giris"
        class="block w-full bg-marka-600 hover:bg-marka-700 text-white font-semibold py-3 rounded-xl text-center gecis mb-2">
        Giriş Yap / Kayıt Ol
      </a>
      <p class="text-center text-xs text-slate-400">30 gün iade garantisi · Güvenli ödeme</p>
    </div>
  </div>

  <footer class="border-t border-slate-200 bg-slate-900 text-slate-400">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 mb-8">
        <!-- Marka -->
        <div>
        <div class="text-xl font-black bg-gradient-to-r from-violet-400 to-purple-300 bg-clip-text text-transparent mb-2">Piex Creative</div>
          <p class="text-sm leading-relaxed">Restoranlar ve kafeler için profesyonel dijital menü çözümü. QR kodu ile anında yayınlayın.</p>
        </div>
        <!-- Hızlı Bağlantılar -->
        <div>
          <h4 class="text-xs font-bold uppercase tracking-widest text-slate-300 mb-3">Hızlı Bağlantılar</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/temalar" class="hover:text-white gecis">Temalar</a></li>
            <li><a href="/hakkimizda" class="hover:text-white gecis">Hakkımızda</a></li>
            <li><a href="/iletisim" class="hover:text-white gecis">İletişim</a></li>
            <li><a href="/giris" class="hover:text-white gecis">Müşteri Girişi</a></li>
          </ul>
        </div>
        <!-- Yasal -->
        <div>
          <h4 class="text-xs font-bold uppercase tracking-widest text-slate-300 mb-3">Yasal Bilgiler</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/gizlilik-politikasi" class="hover:text-white gecis">Gizlilik Politikası</a></li>
            <li><a href="/mesafeli-satis-sozlesmesi" class="hover:text-white gecis">Mesafeli Satış Sözleşmesi</a></li>
            <li><a href="/iptal-ve-iade" class="hover:text-white gecis">İptal ve İade Politikası</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-slate-700 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
        <span>© <%= new Date().getFullYear() %> Piex Creative — Tüm hakları saklıdır.</span>
        <span>Güvenli ödeme · 30 gün iade garantisi</span>
      </div>
    </div>
  </footer>

  <script>
    var GS = { seciliTemaId: '', seciliTemaSlug: '', girisYapildi: <%- kullanici ? 'true' : 'false' %> };

    // Arama
    document.getElementById('arama').addEventListener('input', function() {
      var aranan = this.value.toLowerCase().trim();
      var kartlar = document.querySelectorAll('.tema-kart');
      var gorunen = 0;
      kartlar.forEach(function(kart) {
        var adi = kart.dataset.temaAdi || '';
        var goster = !aranan || adi.includes(aranan);
        kart.style.display = goster ? '' : 'none';
        if (goster) gorunen++;
      });
      document.getElementById('tema-sayisi').textContent = '(' + gorunen + ')';
      document.getElementById('bos-sonuc').classList.toggle('hidden', gorunen > 0);
    });

    function satinAlBaslat(temaId, temaSlug) {
      GS.seciliTemaId = temaId;
      GS.seciliTemaSlug = temaSlug;
      if (!GS.girisYapildi) {
        var link = document.getElementById('auth-modal-link');
        if (link) link.href = '/admin?sonra=/odeme/simule?temaId=' + temaId;
        document.getElementById('auth-modal').classList.remove('hidden');
        return;
      }
      window.location.href = '/odeme/simule?temaId=' + temaId;
    }
  </script>
</body>
</html>
