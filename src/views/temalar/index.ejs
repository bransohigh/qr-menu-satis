            <% } else if (k.duzen === 'premium-koyu') { %>
              <div class="p-1.5 space-y-1" style="background:rgba(7,7,20,.9)">
                <div class="h-3 rounded w-1/2" style="background:linear-gradient(90deg,#c084fc,#f472b6);opacity:.5"></div>
                <div class="grid grid-cols-3 gap-1 mt-0.5">
                  <div class="h-8 rounded-lg border" style="background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.07)"></div>
                  <div class="h-8 rounded-lg border" style="background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.07)"></div>
                  <div class="h-8 rounded-lg border" style="background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.07)"></div>
                </div>
              </div>
            <% } else if (k.duzen === 'bistro-editoryal') { %>
              <div class="p-1.5 space-y-1">
                <div class="h-2 bg-zinc-800 rounded w-3/5"></div>
                <div class="border-b-2 border-zinc-900 pb-1"></div>
                <div class="flex justify-between items-center">
                  <div class="h-1.5 bg-zinc-200 rounded w-1/2"></div>
                  <div class="h-1.5 bg-zinc-700 rounded w-1/5"></div>
