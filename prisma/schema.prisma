generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model categories {
  id         String     @id
  menu_id    String
  name       String
  sort_order Int        @default(0)
  created_at DateTime   @default(now())
  slug       String     @default("")
  menus      menus      @relation(fields: [menu_id], references: [id], onDelete: Cascade)
  products   products[]

  @@unique([menu_id, slug])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model menus {
  id            String       @id
  user_id       String       @unique
  theme_id      String
  slug          String       @unique
  business_name String?
  created_at    DateTime     @default(now())
  updated_at    DateTime
  categories    categories[]
  themes        themes       @relation(fields: [theme_id], references: [id])
  users         users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  products      products[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model products {
  id          String     @id
  menu_id     String
  category_id String
  name        String
  description String     @default("")
  price       Decimal    @db.Decimal(10, 2)
  image_url   String?
  created_at  DateTime   @default(now())
  slug        String     @default("")
  views       Int        @default(0)
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade)
  menus       menus      @relation(fields: [menu_id], references: [id], onDelete: Cascade)

  @@unique([menu_id, slug])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model purchases {
  id           String   @id
  user_id      String
  theme_id     String
  amount       Decimal  @db.Decimal(10, 2)
  currency     String   @default("USD")
  status       String   @default("pending")
  provider     String   @default("fakepay")
  provider_ref String?
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())
  themes       themes   @relation(fields: [theme_id], references: [id])
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([theme_id])
  @@index([user_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model themes {
  id            String      @id
  name          String
  slug          String      @unique
  template_key  String      @unique
  preview_image String
  description   String      @default("")
  created_at    DateTime    @default(now())
  price         Decimal     @default(29.99) @db.Decimal(10, 2)
  currency      String      @default("USD")
  features      String[]    @default([])
  menus         menus[]
  purchases     purchases[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id            String      @id
  email         String      @unique
  password_hash String
  created_at    DateTime    @default(now())
  role          Role        @default(MUSTERI)
  menus         menus?
  purchases     purchases[]
}

enum Role {
  MUSTERI
  ADMIN
}
