generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Row level security enabled on the underlying table. Visit https://pris.ly/d/row-level-security for more info.
model Category {
  id        String    @id
  menuId    String    @map("menu_id")
  name      String
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  slug      String    @default("")
  menu      Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([menuId, slug])
  @@map("categories")
}

/// Row level security enabled on the underlying table. Visit https://pris.ly/d/row-level-security for more info.
model Menu {
  id           String     @id
  userId       String     @unique @map("user_id")
  themeId      String     @map("theme_id")
  slug         String     @unique
  businessName String?    @map("business_name")
  logoUrl      String?    @map("logo_url")
  brand        Json?      @map("brand")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @map("updated_at")
  categories   Category[]
  theme        Theme      @relation(fields: [themeId], references: [id])
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  products     Product[]

  @@map("menus")
}

/// Row level security enabled on the underlying table. Visit https://pris.ly/d/row-level-security for more info.
model Product {
  id          String   @id
  menuId      String   @map("menu_id")
  categoryId  String   @map("category_id")
  name        String
  description String   @default("")
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  slug        String   @default("")
  views       Int      @default(0)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  menu        Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([menuId, slug])
  @@map("products")
}

/// Row level security enabled on the underlying table. Visit https://pris.ly/d/row-level-security for more info.
model Purchase {
  id          String   @id
  userId      String   @map("user_id")
  themeId     String   @map("theme_id")
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  status      String   @default("pending")
  provider    String   @default("fakepay")
  providerRef String?  @map("provider_ref")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  theme       Theme    @relation(fields: [themeId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([themeId])
  @@index([userId])
  @@map("purchases")
}

/// Row level security enabled on the underlying table. Visit https://pris.ly/d/row-level-security for more info.
model Theme {
  id           String     @id
  name         String
  slug         String     @unique
  templateKey  String     @unique @map("template_key")
  previewImage String     @map("preview_image")
  description  String     @default("")
  createdAt    DateTime   @default(now()) @map("created_at")
  price        Decimal    @default(29.99) @db.Decimal(10, 2)
  currency     String     @default("USD")
  features     String[]   @default([])
  isNew        Boolean    @default(false) @map("is_new")
  menus        Menu[]
  purchases    Purchase[]

  @@map("themes")
}

/// Row level security enabled on the underlying table. Visit https://pris.ly/d/row-level-security for more info.
model User {
  id           String     @id
  email        String     @unique
  passwordHash String     @map("password_hash")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @default(MUSTERI)
  menu         Menu?
  purchases    Purchase[]

  @@map("users")
}

enum Role {
  MUSTERI
  ADMIN
}
